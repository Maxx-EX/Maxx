<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5">

    <!-- Title bar: light, rounded bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#f1f3f5"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maxx 编译器"
                android:textColor="#212529"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/save_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无修改"
                android:textColor="#6c757d"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/run_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="运行"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:background="@drawable/bg_run_button"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/menu_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⋮"
            android:textColor="#495057"
            android:textSize="18sp"
            android:background="@drawable/bg_tool_btn"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </LinearLayout>

    <!-- Code editor with line numbers -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="horizontal"
        android:layout_margin="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="@drawable/bg_editor_card"
            android:padding="4dp">

            <!-- Line numbers -->
            <TextView
                android:id="@+id/line_numbers"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:textColor="#868e96"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:gravity="top|end"
                android:text="1" />

            <!-- Code input -->
            <EditText
                android:id="@+id/code_editor"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="top|start"
                android:hint="// Write Maxx code here..."
                android:textColorHint="#adb5bd"
                android:inputType="textMultiLine|textNoSuggestions"
                android:textSize="13sp"
                android:textColor="#212529"
                android:fontFamily="monospace"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:scrollbars="vertical"
                android:minWidth="300dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Keyboard toolbar row 1 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#f1f3f5"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/toolbar_row1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="6dp" />
    </HorizontalScrollView>

    <!-- Keyboard toolbar row 2 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#f1f3f5"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/toolbar_row2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="6dp" />
    </HorizontalScrollView>

</LinearLayout>
