// algorithms/bit_manipulation.max - Bit manipulation demo
~ std.io

@ main() -> int:
    let x = 5  // 101 in binary
    io.println("Bit Manipulation Demo")
    io.println("x = " + str(x))
    io.println("x & 1 = " + str(x & 1))
    io.println("x | 2 = " + str(x | 2))
    io.println("x << 1 = " + str(x << 1))
    io.println("x >> 1 = " + str(x >> 1))
    ret 0
