// algorithms/merge_sort.max - Merge sort demo
~ std.io

@ main() -> int:
    io.println("Merge Sort Demo")
    io.println("(Full implementation pending - demo version)")
    let arr = [5, 2, 8, 1, 9, 3]
    io.print("Array: ")
    var i = 0
    while i < 6:
        io.print(str(arr[i]) + " ")
        i = i + 1
    io.println("")
    ret 0
