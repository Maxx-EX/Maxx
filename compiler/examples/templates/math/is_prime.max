// math/is_prime.max - Prime number check
~ std.io

@ is_prime(n: int) -> int:
    if n < 2:
        ret 0
    var i = 2
    while i * i <= n:
        if n % i == 0:
            ret 0
        i = i + 1
    ret 1

@ main() -> int:
    io.println("Prime Numbers Demo")
    var n = 2
    var count = 0
    while count < 10:
        if is_prime(n) == 1:
            io.print(str(n) + " ")
            count = count + 1
        n = n + 1
    io.println("")
    ret 0
