// strings/count_vowels.max - Count vowels in string
~ std.io
~ std.text

@ main() -> int:
    let s = "hello world"
    var count = 0
    var i = 0
    let len = str_len(s)
    
    while i < len:
        let c = str_char_at(s, i)
        if c == "a" || c == "e" || c == "i" || c == "o" || c == "u":
            count = count + 1
        i = i + 1
    
    io.println("Vowels in '" + s + "': " + str(count))
    ret 0
