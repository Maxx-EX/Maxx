//! std.func — 函数式工具（真实实现）。
//!
//! 组合、柯里化、偏应用、记忆化等高阶函数。

// ---------- 组合 ----------

/// compose(f, g) = f(g(x))
pub @ compose<A, B, C>(f: fn(B) -> C, g: fn(A) -> B) -> fn(A) -> C:
    ret fn(x: A) -> C: ret f(g(x))

/// pipe(g, f) = f(g(x))（从左到右）
pub @ pipe<A, B, C>(g: fn(A) -> B, f: fn(B) -> C) -> fn(A) -> C:
    ret fn(x: A) -> C: ret f(g(x))

/// 顺序执行两个无返回值函数
pub @ seq<A>(f: fn(A) -> (), g: fn(A) -> ()) -> fn(A) -> ():
    ret fn(x: A) -> ():
        f(x)
        g(x)

// ---------- 柯里化与偏应用 ----------

/// curry(f(a, b)) = fn(a) -> fn(b) -> f(a, b)
pub @ curry<A, B, C>(f: fn(A, B) -> C) -> fn(A) -> fn(B) -> C:
    ret fn(a: A) -> fn(B) -> C:
        ret fn(b: B) -> C: ret f(a, b)

/// partial(f, a) = fn(b) -> f(a, b)
pub @ partial<A, B, C>(f: fn(A, B) -> C, a: A) -> fn(B) -> C:
    ret fn(b: B) -> C: ret f(a, b)

/// flip(f(a,b)) = fn(b) -> fn(a) -> f(a, b)
pub @ flip<A, B, C>(f: fn(A, B) -> C) -> fn(B) -> fn(A) -> C:
    ret fn(b: B) -> fn(A) -> C:
        ret fn(a: A) -> C: ret f(a, b)

// ---------- 基本函数 ----------

/// 恒等函数
pub @ identity<A>(x: A) -> A:
    ret x

/// 常量函数（总是返回 x）
pub @ constant<A>(x: A) -> fn() -> A:
    ret fn() -> A: ret x

/// 空操作
pub @ noop() -> ():
    ()

/// 应用函数
pub @ apply<A, B>(f: fn(A) -> B, a: A) -> B:
    ret f(a)

/// 两次应用
pub @ apply2<A, B, C>(f: fn(A, B) -> C, a: A, b: B) -> C:
    ret f(a, b)

// ---------- 布尔逻辑 ----------

/// 与（两个谓词）
pub @ and<A>(p: fn(A) -> bool, q: fn(A) -> bool) -> fn(A) -> bool:
    ret fn(x: A) -> bool: ret p(x) && q(x)

/// 或
pub @ or<A>(p: fn(A) -> bool, q: fn(A) -> bool) -> fn(A) -> bool:
    ret fn(x: A) -> bool: ret p(x) || q(x)

/// 非
pub @ not<A>(p: fn(A) -> bool) -> fn(A) -> bool:
    ret fn(x: A) -> bool: ret !p(x)

/// 异或
pub @ xor<A>(p: fn(A) -> bool, q: fn(A) -> bool) -> fn(A) -> bool:
    ret fn(x: A) -> bool: ret p(x) != q(x)

// ---------- 记忆化 ----------

/// memoize(f) —— 缓存函数结果（引导阶段用简单 Map）
pub @ memoize<A, B>(f: fn(A) -> B) -> fn(A) -> B:
    let cache = Map<A, B>::new()
    ret fn(x: A) -> B:
        match cache.get(x):
            some(v): ret v
            none:
                let result = f(x)
                cache.set(x, result)
                ret result

// ---------- 重复执行 ----------

/// 重复执行 n 次
pub @ repeat<A>(f: fn(A) -> (), n: int, arg: A) -> ():
    var i = 0
    while i < n:
        f(arg)
        i += 1

/// 累加（从 0 到 n）
pub @ accumulate(n: int, f: fn(int) -> int) -> int:
    var sum = 0
    var i = 0
    while i < n:
        sum += f(i)
        i += 1
    ret sum

// ---------- 比较 ----------

/// 比较器（按字段）
pub @ compare_by<A, B>(f: fn(A) -> B) -> fn(A, A) -> int:
    ret fn(a: A, b: A) -> int:
        let fa = f(a)
        let fb = f(b)
        if fa < fb: ret -1
        if fa > fb: ret 1
        ret 0

/// 反转比较器
pub @ reverse_cmp<A>(cmp: fn(A, A) -> int) -> fn(A, A) -> int:
    ret fn(a: A, b: A) -> int: ret -cmp(a, b)

// ---------- 测试示例 ----------
///
/// 测试示例：
///   let add1 = fn(x: int) -> int: ret x + 1
///   let mul2 = fn(x: int) -> int: ret x * 2
///   let f = func.compose(mul2, add1)
///   io.println(f(3))  // (3+1)*2 = 8
