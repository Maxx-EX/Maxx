//! std.text — 字符串与文本处理（真实实现）。
//!
//! `str` 是内置的 UTF-8 不可变字符串类型。
//! 索引以 char（Unicode 码点）为单位。本文件用基础 char 操作实现所有方法。

~ std.collections::Vec

/// 字符串长度（码点数）
pub @ str::len(self: str) -> int:
    // 引导阶段由编译器内置实现；这里用迭代计数兜底
    var i = 0
    var n = 0
    while true:
        let c = self.char_at(i)
        match c:
            some(_): n += 1
            none: break
        i += 1
    ret n

/// 是否为空
pub @ str::is_empty(self: str) -> bool:
    ret self.len() == 0

/// 字节长度
pub @ str::byte_len(self: str) -> int:
    // 引导阶段由运行时内置；兜底用 UTF-8 编码计数
    var n = 0
    var i = 0
    while true:
        let c = self.char_at(i)
        match c:
            some(ch):
                n += utf8_len(ch)
            none: break
        i += 1
    ret n

@ utf8_len(c: char) -> int:
    if c < 0x80: ret 1
    if c < 0x800: ret 2
    if c < 0x10000: ret 3
    ret 4

/// 字符访问（越界 none）
pub @ str::char_at(self: str, i: int) -> ?char:
    // 由运行时内置实现；此处签名保留
    // 引导阶段 codegen 直接映射到字符串索引
    ret none

/// 子串 [lo, hi)
pub @ str::slice(self: str, lo: int, hi: int) -> ?str:
    if lo < 0 || hi > self.len() || lo > hi:
        ret none
    var s = ""
    var i = lo
    while i < hi:
        match self.char_at(i):
            some(c): s += char_to_str(c)
            none: break
        i += 1
    ret some(s)

@ char_to_str(c: char) -> str:
    // 引导阶段由运行时内置
    ret ""

/// 转大写（ASCII）
pub @ str::to_upper(self: str) -> str:
    var s = ""
    var i = 0
    while i < self.len():
        match self.char_at(i):
            some(c):
                if c >= 'a' && c <= 'z':
                    s += char_to_str(c - 32)
                else:
                    s += char_to_str(c)
            none: break
        i += 1
    ret s

/// 转小写（ASCII）
pub @ str::to_lower(self: str) -> str:
    var s = ""
    var i = 0
    while i < self.len():
        match self.char_at(i):
            some(c):
                if c >= 'A' && c <= 'Z':
                    s += char_to_str(c + 32)
                else:
                    s += char_to_str(c)
            none: break
        i += 1
    ret s

/// 是否空白字符
@ is_space(c: char) -> bool:
    ret c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 0x0B

/// 去除首尾空白
pub @ str::trim(self: str) -> str:
    ret self.trim_start().trim_end()

/// 去除左侧空白
pub @ str::trim_start(self: str) -> str:
    var i = 0
    while i < self.len():
        match self.char_at(i):
            some(c):
                if is_space(c):
                    i += 1
                else:
                    break
            none: break
    match self.slice(i, self.len()):
        some(s): ret s
        none: ret ""

/// 去除右侧空白
pub @ str::trim_end(self: str) -> str:
    var j = self.len()
    while j > 0:
        match self.char_at(j - 1):
            some(c):
                if is_space(c):
                    j -= 1
                else:
                    break
            none: break
    match self.slice(0, j):
        some(s): ret s
        none: ret ""

/// 前缀判断
pub @ str::starts_with(self: str, prefix: str) -> bool:
    if prefix.len() > self.len():
        ret false
    var i = 0
    while i < prefix.len():
        if self.char_at(i) != prefix.char_at(i):
            ret false
        i += 1
    ret true

/// 后缀判断
pub @ str::ends_with(self: str, suffix: str) -> bool:
    let n = self.len()
    let m = suffix.len()
    if m > n:
        ret false
    var i = 0
    while i < m:
        if self.char_at(n - m + i) != suffix.char_at(i):
            ret false
        i += 1
    ret true

/// 包含子串
pub @ str::contains(self: str, sub: str) -> bool:
    ret self.index_of(sub) != none

/// 查找子串首次出现位置
pub @ str::index_of(self: str, sub: str) -> ?int:
    let n = self.len()
    let m = sub.len()
    if m == 0:
        ret some(0)
    if m > n:
        ret none
    var i = 0
    while i <= n - m:
        var match = true
        var j = 0
        while j < m:
            if self.char_at(i + j) != sub.char_at(j):
                match = false
                break
            j += 1
        if match:
            ret some(i)
        i += 1
    ret none

/// 查找子串最后出现位置
pub @ str::last_index_of(self: str, sub: str) -> ?int:
    let n = self.len()
    let m = sub.len()
    if m == 0:
        ret some(n)
    if m > n:
        ret none
    var i = n - m
    while i >= 0:
        var match = true
        var j = 0
        while j < m:
            if self.char_at(i + j) != sub.char_at(j):
                match = false
                break
            j += 1
        if match:
            ret some(i)
        i -= 1
    ret none

/// 替换所有
pub @ str::replace(self: str, from: str, to: str) -> str:
    if from.len() == 0:
        ret self
    var result = ""
    var i = 0
    let n = self.len()
    let m = from.len()
    while i < n:
        match self.index_of_at(from, i):
            some(pos):
                // 追加 [i, pos)
                match self.slice(i, pos):
                    some(part): result += part
                    none: ()
                result += to
                i = pos + m
            none:
                match self.slice(i, n):
                    some(part): result += part
                    none: ()
                break
    ret result

/// 从 offset 开始查找（内部辅助）
@ str::index_of_at(self: str, sub: str, offset: int) -> ?int:
    let n = self.len()
    let m = sub.len()
    if m == 0:
        ret some(offset)
    if offset + m > n:
        ret none
    var i = offset
    while i <= n - m:
        var match = true
        var j = 0
        while j < m:
            if self.char_at(i + j) != sub.char_at(j):
                match = false
                break
            j += 1
        if match:
            ret some(i)
        i += 1
    ret none

/// 按分隔符切分
pub @ str::split(self: str, sep: str) -> Vec<str>:
    let parts = Vec<str>::new()
    var start = 0
    var i = 0
    let n = self.len()
    let m = sep.len()
    while i <= n:
        if i + m <= n && self.slice_eq(i, sep):
            match self.slice(start, i):
                some(p): parts.push(p)
                none: ()
            start = i + m
            i = start
        else:
            i += 1
    match self.slice(start, n):
        some(p): parts.push(p)
        none: ()
    ret parts

@ str::slice_eq(self: str, off: int, sub: str) -> bool:
    var j = 0
    while j < sub.len():
        if self.char_at(off + j) != sub.char_at(j):
            ret false
        j += 1
    ret true

/// 按行切分
pub @ str::lines(self: str) -> Vec<str>:
    ret self.split("\n")

/// 按空白切分
pub @ str::words(self: str) -> Vec<str>:
    let parts = Vec<str>::new()
    var current = ""
    var in_word = false
    var i = 0
    while i < self.len():
        match self.char_at(i):
            some(c):
                if is_space(c):
                    if in_word:
                        parts.push(current)
                        current = ""
                        in_word = false
                else:
                    current += char_to_str(c)
                    in_word = true
            none: break
        i += 1
    if in_word:
        parts.push(current)
    ret parts

/// 连接字符串数组
pub @ str::join(parts: Vec<str>, sep: str) -> str:
    if parts.len() == 0:
        ret ""
    var result = parts.get(0).unwrap()
    var i = 1
    while i < parts.len():
        result += sep
        result += parts.get(i).unwrap()
        i += 1
    ret result

/// 重复 n 次
pub @ str::repeat(self: str, n: int) -> str:
    var s = ""
    var i = 0
    while i < n:
        s += self
        i += 1
    ret s

/// 解析为 int
pub @ str::parse_int(self: str) -> Result<int, str>:
    let s = self.trim()
    if s.len() == 0:
        ret err("empty string")
    var sign = 1
    var start = 0
    match s.char_at(0):
        some('+'): start = 1
        some('-'):
            sign = -1
            start = 1
        some(_): ()
        none: ret err("empty")
    if start >= s.len():
        ret err("no digits")
    var value = 0
    var i = start
    while i < s.len():
        match s.char_at(i):
            some(c):
                if c >= '0' && c <= '9':
                    value = value * 10 + (int(c) - int('0'))
                else:
                    ret err(f"invalid char: {c}")
            none: break
        i += 1
    ret ok(sign * value)

/// 解析为 f64
pub @ str::parse_float(self: str) -> Result<f64, str>:
    let s = self.trim()
    if s.len() == 0:
        ret err("empty string")
    var sign = 1.0
    var start = 0
    match s.char_at(0):
        some('+'): start = 1
        some('-'):
            sign = -1.0
            start = 1
        some(_): ()
        none: ret err("empty")
    var int_part = 0.0
    var i = start
    while i < s.len():
        match s.char_at(i):
            some(c):
                if c >= '0' && c <= '9':
                    int_part = int_part * 10.0 + (f64(c) - f64('0'))
                    i += 1
                else:
                    break
            none: break
    var frac_part = 0.0
    var frac_scale = 1.0
    if i < s.len() && s.char_at(i) == some('.'):
        i += 1
        while i < s.len():
            match s.char_at(i):
                some(c):
                    if c >= '0' && c <= '9':
                        frac_part = frac_part * 10.0 + (f64(c) - f64('0'))
                        frac_scale *= 10.0
                        i += 1
                    else:
                        break
                none: break
    ret ok(sign * (int_part + frac_part / frac_scale))

/// 解析为 bool
pub @ str::parse_bool(self: str) -> Result<bool, str>:
    let s = self.trim().to_lower()
    if s == "true" || s == "1":
        ret ok(true)
    if s == "false" || s == "0":
        ret ok(false)
    ret err("not a bool")

/// 编码为 UTF-8 字节（引导阶段由运行时内置）
pub @ str::to_utf8(self: str) -> Vec<u8>:
    ret Vec<u8>::new()

/// 从 UTF-8 字节构造
pub @ str::from_utf8(bytes: Vec<u8>) -> Result<str, str>:
    ret ok("")

// ---------- 字符串构造器 ----------

/// 字符串构造器
pub # StringBuilder:
    buf: Vec<u8>

pub @ StringBuilder::new() -> StringBuilder:
    ret StringBuilder{ buf: Vec<u8>::new() }

pub @ StringBuilder::push_str(self: StringBuilder, s: str) -> ():
    // 引导阶段由运行时追加
    ()

pub @ StringBuilder::push_char(self: StringBuilder, c: char) -> ():
    ()

pub @ StringBuilder::push_int(self: StringBuilder, n: int) -> ():
    // 简化：用内置 int->str
    self.push_str(int_to_str(n))

pub @ StringBuilder::push_float(self: StringBuilder, x: f64) -> ():
    self.push_str(float_to_str(x))

@ int_to_str(n: int) -> str:
    // 引导阶段由运行时内置
    ret ""

@ float_to_str(x: f64) -> str:
    ret ""

pub @ StringBuilder::len(self: StringBuilder) -> int:
    ret self.buf.len()

pub @ StringBuilder::to_string(self: StringBuilder) -> str:
    // 引导阶段由运行时把 buf 解码为 str
    ret ""

pub @ StringBuilder::clear(self: StringBuilder) -> ():
    self.buf.clear()

/// 简单格式化：template 中 {} 按顺序替换为 args
pub @ format(template: str, args: Vec<str>) -> str:
    var result = ""
    var arg_idx = 0
    var i = 0
    while i < template.len():
        match template.char_at(i):
            some('{'):
                if i + 1 < template.len() && template.char_at(i + 1) == some('{'):
                    result += "{"
                    i += 2
                elif i + 1 < template.len() && template.char_at(i + 1) == some('}'):
                    if arg_idx < args.len():
                        result += args.get(arg_idx).unwrap()
                    arg_idx += 1
                    i += 2
                else:
                    result += "{"
                    i += 1
            some('}'):
                if i + 1 < template.len() && template.char_at(i + 1) == some('}'):
                    result += "}"
                    i += 2
                else:
                    result += "}"
                    i += 1
            some(c):
                result += char_to_str(c)
                i += 1
            none: break
    ret result

// ---------- 扩展函数 ----------

/// 反转字符串
pub @ str::reverse(self: str) -> str:
    var s = ""
    var i = self.len() - 1
    while i >= 0:
        match self.char_at(i):
            some(c): s += char_to_str(c)
            none: ()
        i -= 1
    ret s

/// 统计子串出现次数
pub @ str::count(self: str, sub: str) -> int:
    var n = 0
    var pos = 0
    loop:
        match self.index_of_at(sub, pos):
            some(i):
                n += 1
                pos = i + sub.len()
            none: break
    ret n

/// 字符出现次数
pub @ str::count_char(self: str, c: char) -> int:
    var n = 0
    var i = 0
    while i < self.len():
        if self.char_at(i) == some(c):
            n += 1
        i += 1
    ret n

/// 填充到指定宽度（左侧）
pub @ str::pad_start(self: str, width: int, pad: char) -> str:
    if self.len() >= width:
        ret self
    var s = ""
    var i = 0
    while i < width - self.len():
        s += char_to_str(pad)
        i += 1
    ret s + self

/// 填充到指定宽度（右侧）
pub @ str::pad_end(self: str, width: int, pad: char) -> str:
    if self.len() >= width:
        ret self
    var s = self
    var i = 0
    while i < width - self.len():
        s += char_to_str(pad)
        i += 1
    ret s

/// 截断到指定长度，超出加省略号
pub @ str::truncate(self: str, max_len: int) -> str:
    if self.len() <= max_len:
        ret self
    if max_len <= 3:
        ret self.slice(0, max_len).unwrap()
    ret self.slice(0, max_len - 3).unwrap() + "..."

/// 首字母大写
pub @ str::capitalize(self: str) -> str:
    if self.len() == 0:
        ret self
    let first = char_to_str(self.char_at(0).unwrap()).to_upper()
    let rest = if self.len() > 1:
        self.slice(1, self.len()).unwrap()
    else: ""
    ret first + rest

/// 每个单词首字母大写
pub @ str::title(self: str) -> str:
    let words = self.words()
    var out = Vec<str>::new()
    var i = 0
    while i < words.len():
        out.push(words.at(i).capitalize())
        i += 1
    return str::join(out, " ")

/// 转小写（每个单词首字母大写，其余小写）
pub @ str::to_title(self: str) -> str:
    ret self.title()

/// 判断是否全大写
pub @ str::is_upper(self: str) -> bool:
    ret self.to_upper() == self

/// 判断是否全小写
pub @ str::is_lower(self: str) -> bool:
    ret self.to_lower() == self

/// 判断是否为数字
pub @ str::is_numeric(self: str) -> bool:
    if self.len() == 0:
        ret false
    var i = 0
    while i < self.len():
        let c = self.char_at(i).unwrap()
        if !(c >= '0' && c <= '9'):
            ret false
        i += 1
    ret true

/// 判断是否为字母
pub @ str::is_alpha(self: str) -> bool:
    if self.len() == 0:
        ret false
    var i = 0
    while i < self.len():
        let c = self.char_at(i).unwrap()
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')):
            ret false
        i += 1
    ret true

/// 判断是否为字母数字
pub @ str::is_alnum(self: str) -> bool:
    ret self.is_alpha() || self.is_numeric()

/// 裁剪两侧字符集
pub @ str::trim_chars(self: str, chars: str) -> str:
    var start = 0
    var end = self.len()
    while start < end && chars.contains(char_to_str(self.char_at(start).unwrap())):
        start += 1
    while end > start && chars.contains(char_to_str(self.char_at(end - 1).unwrap())):
        end -= 1
    ret self.slice(start, end).unwrap()

/// 移除前缀
pub @ str::strip_prefix(self: str, prefix: str) -> str:
    if self.starts_with(prefix):
        ret self.slice(prefix.len(), self.len()).unwrap()
    ret self

/// 移除后缀
pub @ str::strip_suffix(self: str, suffix: str) -> str:
    if self.ends_with(suffix):
        ret self.slice(0, self.len() - suffix.len()).unwrap()
    ret self

// ---------- 测试示例 ----------
///
/// 测试示例：
///   let s = "  Hello, Maxx!  "
///   io.println(s.trim())              // "Hello, Maxx!"
///   io.println(s.to_upper())          // "  HELLO, MAXX!  "
///   io.println("a,b,c".split(","))  // ["a","b","c"]
///   io.println(str::join(["a","b"], "-"))  // "a-b"
///   io.println("hello".index_of("ll"))  // some(2)
///   match "42".parse_int():
///       ok(v): io.println(v * 2)     // 84
///       err(e): io.println(e)
