#!/usr/bin/env bash
# Maxx 单文件安装器
# 用法: curl -sSL https://raw.githubusercontent.com/Maxx-EX/Maxx/main/maxx-install | bash
# 或: wget -qO- https://raw.githubusercontent.com/Maxx-EX/Maxx/main/maxx-install | bash

set -e

# 颜色
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${BLUE}[*]${NC} $1"; }
success() { echo -e "${GREEN}[✓]${NC} $1"; }
warn() { echo -e "${YELLOW}[!]${NC} $1"; }
error() { echo -e "${RED}[✗]${NC} $1"; exit 1; }

echo "=========================================="
echo "  Maxx 单文件安装器"
echo "=========================================="
echo ""

# ---- 1. 检测环境 ----
info "检测运行环境..."

# 检测 Python
if command -v python3 &> /dev/null; then
    PY=python3
    success "找到 Python: $(python3 --version 2>&1)"
elif command -v python &> /dev/null; then
    PY=python
    success "找到 Python: $(python --version 2>&1)"
else
    warn "未找到 Python，尝试安装..."
    if command -v pkg &> /dev/null; then
        pkg install -y python
    elif command -v apt &> /dev/null; then
        sudo apt update && sudo apt install -y python3
    elif command -v yum &> /dev/null; then
        sudo yum install -y python3
    else
        error "请先安装 Python 3"
    fi
    PY=python3
fi

# 检测 gcc
HAS_CC=false
if command -v cc &> /dev/null; then
    HAS_CC=true
    success "找到 C 编译器"
elif command -v gcc &> /dev/null; then
    HAS_CC=true
    success "找到 C 编译器"
elif command -v clang &> /dev/null; then
    HAS_CC=true
    success "找到 C 编译器"
else
    warn "未找到 C 编译器，尝试安装..."
    if command -v pkg &> /dev/null; then
        pkg install -y clang
    elif command -v apt &> /dev/null; then
        sudo apt install -y build-essential
    fi
fi

# ---- 2. 确定安装路径 ----
info "配置安装路径..."

if [ -d "/data/data/com.termux" ]; then
    PREFIX_DIR="/data/data/com.termux/files/usr"
    info "检测到 Termux 环境"
else
    PREFIX_DIR="$HOME/.local"
    info "检测到 Linux 环境"
fi

BIN_DIR="$PREFIX_DIR/bin"
LIB_DIR="$PREFIX_DIR/lib/maxx"
mkdir -p "$BIN_DIR" "$LIB_DIR"

# ---- 3. 下载编译器 ----
info "下载 Maxx 编译器..."

REPO="https://github.com/Maxx-EX/Maxx"
RAW="https://raw.githubusercontent.com/Maxx-EX/Maxx/main"

# 下载核心编译器文件
info "下载编译器核心文件..."

# 下载 maxxc.py
curl -sSL "$RAW/compiler/maxxc.py" -o "$LIB_DIR/maxxc.py" 2>/dev/null || \
    error "下载 maxxc.py 失败"

# 下载其他编译器文件
for f in lexer.py parser.py checker.py codegen_c.py mxast.py; do
    info "下载 $f..."
    curl -sSL "$RAW/compiler/$f" -o "$LIB_DIR/$f" 2>/dev/null || \
        warn "下载 $f 失败（可能不需要）"
done

# 下载运行时
info "下载运行时..."
curl -sSL "$RAW/compiler/runtime_minimal.c" -o "$LIB_DIR/runtime_minimal.c" 2>/dev/null || true
curl -sSL "$RAW/compiler/runtime_minimal.h" -o "$LIB_DIR/runtime_minimal.h" 2>/dev/null || true

success "编译器下载完成"

# ---- 4. 创建 maxx 命令 ----
info "创建 maxx 命令..."

cat > "$BIN_DIR/maxx" << EOF
#!/usr/bin/env bash
# Maxx 命令行工具
MAXX_LIB="$LIB_DIR"

if [ ! -f "\$MAXX_LIB/maxxc.py" ]; then
    echo "错误: 找不到 Maxx 编译器"
    echo "请重新运行安装脚本"
    exit 1
fi

case "\${1:-}" in
    "")
        $PY \$MAXX_LIB/maxxc.py repl
        ;;
    "repl")
        $PY \$MAXX_LIB/maxxc.py repl
        ;;
    "run")
        shift
        $PY \$MAXX_LIB/maxxc.py run "\$@"
        ;;
    "build")
        shift
        $PY \$MAXX_LIB/maxxc.py build "\$@"
        ;;
    "version"|"--version"|"-v")
        echo "Maxx v1.0.0 (bootstrap)"
        echo "编译器: Python Level-1"
        echo "仓库: $REPO"
        ;;
    "help"|"--help"|"-h")
        echo "Maxx 命令行工具"
        echo ""
        echo "用法:"
        echo "  maxx              进入 REPL"
        echo "  maxx run <file>   运行 .max 文件"
        echo "  maxx build <file> 编译 .max 文件"
        echo "  maxx version      显示版本"
        echo ""
        echo "彩蛋: hi！Maxx"
        ;;
    *)
        $PY \$MAXX_LIB/maxxc.py "\$@"
        ;;
esac
EOF

chmod +x "$BIN_DIR/maxx"
success "maxx 命令已安装: $BIN_DIR/maxx"

# ---- 5. 配置 PATH ----
info "配置 PATH..."

SHELL_RC=""
if [ -f "$HOME/.bashrc" ]; then
    SHELL_RC="$HOME/.bashrc"
elif [ -f "$HOME/.zshrc" ]; then
    SHELL_RC="$HOME/.zshrc"
fi

if [ -n "$SHELL_RC" ]; then
    if ! grep -q "MAXX_LIB" "$SHELL_RC" 2>/dev/null; then
        echo "" >> "$SHELL_RC"
        echo "# Maxx Language" >> "$SHELL_RC"
        echo "export PATH=\"$BIN_DIR:\$PATH\"" >> "$SHELL_RC"
        success "已添加到 $SHELL_RC"
    else
        info "PATH 已配置"
    fi
fi

# ---- 6. 验证安装 ----
info "验证安装..."

export PATH="$BIN_DIR:$PATH"

if command -v maxx &> /dev/null; then
    success "maxx 命令可用"
else
    warn "请运行: source $SHELL_RC"
fi

# ---- 7. 完成 ----
echo ""
echo "=========================================="
success "Maxx 安装完成!"
echo "=========================================="
echo ""
echo "快速开始:"
echo "  1. source $SHELL_RC"
echo "  2. maxx              (进入 REPL)"
echo "  3. maxx run hello.max"
echo ""
echo "彩蛋: 在 REPL 里输入 hi！Maxx"
echo ""
