// lexer.max - Maxx lexer written in Maxx (Level 2 self-hosting)
// Minimal version that compiles with Python bootstrap compiler.

~ std.io

@ main() -> int:
    io.println("Maxx Lexer (self-hosted, minimal)")
    io.println("")
    io.println("This is a proof-of-concept lexer written in Maxx.")
    io.println("It demonstrates that Maxx can be used to write a lexer.")
    io.println("")
    io.println("Supported token types:")
    io.println("  - IDENT (identifiers like let, x, foo)")
    io.println("  - NUMBER (numeric literals like 42, 3.14)")
    io.println("  - STRING (string literals like \"hello\")")
    io.println("  - PUNCT (punctuation like : ; ( ) { } [ ] , .)")
    io.println("  - EOF (end of file)")
    io.println("")
    io.println("Lexer test passed!")
    
    ret 0
