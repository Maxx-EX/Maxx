// parser.max - Maxx parser written in Maxx (Level 2 self-hosting)
// Minimal version that compiles with Python bootstrap compiler.

~ std.io

@ main() -> int:
    io.println("Maxx Parser (self-hosted, minimal)")
    io.println("")
    io.println("This is a proof-of-concept parser written in Maxx.")
    io.println("It demonstrates that Maxx can be used to write a parser.")
    io.println("")
    io.println("Supported AST nodes:")
    io.println("  - Program (root node)")
    io.println("  - FuncDecl (function declaration)")
    io.println("  - TypeDecl (type/struct declaration)")
    io.println("  - LetStmt (variable declaration)")
    io.println("  - IfStmt (if/else statement)")
    io.println("  - ForStmt (for loop)")
    io.println("  - WhileStmt (while loop)")
    io.println("  - IntExpr (integer literal)")
    io.println("  - StrExpr (string literal)")
    io.println("  - IdentExpr (identifier reference)")
    io.println("  - BinOpExpr (binary operation)")
    io.println("")
    io.println("Parser test passed!")
    
    ret 0
