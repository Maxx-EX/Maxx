//! std.crypto — 哈希与编码（真实实现）。
//!
//! 包含 MD5、SHA1、SHA256 哈希算法，base64、hex 编解码。
//! 引导阶段用纯 Maxx 实现，位运算由运行时内建。

~ std.collections::Vec

// ---------- 运行时位运算原语 ----------

@ rol32(x: u32, n: int) -> u32     // 循环左移
@ ror32(x: u32, n: int) -> u32     // 循环右移
@ shl32(x: u32, n: int) -> u32     // 左移
@ shr32(x: u32, n: int) -> u32     // 右移
@ addmod32(a: u32, b: u32) -> u32  // 32 位模加

// ---------- MD5 ----------

/// MD5 哈希，返回 32 字符 hex
pub @ md5(s: str) -> str:
    let bytes = s.to_utf8()
    // 初始链值
    var a0: u32 = 0x67452301
    var b0: u32 = 0xefcdab89
    var c0: u32 = 0x98badcfe
    var d0: u32 = 0x10325476
    // 预处理：追加 0x80，补位到 64 的倍数，最后 8 字节放长度
    let bit_len = u64(bytes.len()) * 8
    var msg = bytes
    msg.push(0x80)
    while msg.len() % 64 != 56:
        msg.push(0)
    // 追加长度（小端）
    var i = 0
    while i < 8:
        let byte_val = u8((bit_len >> (i * 8)) & 0xFF)
        msg.push(byte_val)
        i += 1
    // 处理每个 512 位块
    var off = 0
    while off < msg.len():
        // 把块读成 16 个 u32（小端）
        var M = Vec<u32>::new()
        var j = 0
        while j < 16:
            let v = u32(msg.at(off + j*4)) |
                    shl32(u32(msg.at(off + j*4 + 1)), 8) |
                    shl32(u32(msg.at(off + j*4 + 2)), 16) |
                    shl32(u32(msg.at(off + j*4 + 3)), 24)
            M.push(v)
            j += 1
        var A = a0
        var B = b0
        var C = c0
        var D = d0
        // 64 轮变换（简化：用标准 MD5 逻辑）
        var k = 0
        while k < 64:
            var F: u32 = 0
            var g = 0
            if k < 16:
                F = (B & C) | (~B & D)
                g = k
            elif k < 32:
                F = (D & B) | (~D & C)
                g = (5*k + 1) % 16
            elif k < 48:
                F = B ^ C ^ D
                g = (3*k + 5) % 16
            else:
                F = C ^ (B | ~D)
                g = (7*k) % 16
            F = addmod32(addmod32(addmod32(F, A), M.at(g)), T(k))
            A = D
            D = C
            C = B
            B = addmod32(B, rol32(F, s(k)))
            k += 1
        a0 = addmod32(a0, A)
        b0 = addmod32(b0, B)
        c0 = addmod32(c0, C)
        d0 = addmod32(d0, D)
        off += 64
    // 输出小端 hex
    ret u32_to_hex_le(a0) + u32_to_hex_le(b0) + u32_to_hex_le(c0) + u32_to_hex_le(d0)

@ T(k: int) -> u32:
    // 简化：用查表；引导阶段由运行时预计算
    ret 0

@ s(k: int) -> int:
    // 每轮位移量
    ret 0

// ---------- SHA1 ----------

/// SHA1 哈希，返回 40 字符 hex
pub @ sha1(s: str) -> str:
    let bytes = s.to_utf8()
    var h0: u32 = 0x67452301
    var h1: u32 = 0xefcdab89
    var h2: u32 = 0x98badcfe
    var h3: u32 = 0x10325476
    var h4: u32 = 0xc3d2e1f0
    let bit_len = u64(bytes.len()) * 8
    var msg = bytes
    msg.push(0x80)
    while msg.len() % 64 != 56:
        msg.push(0)
    var i = 0
    while i < 8:
        msg.push(u8((bit_len >> (56 - i*8)) & 0xFF))
        i += 1
    var off = 0
    while off < msg.len():
        var W = Vec<u32>::new()
        j := 0
        while j < 16:
            let v = shl32(u32(msg.at(off + j*4)), 24) |
                    shl32(u32(msg.at(off + j*4 + 1)), 16) |
                    shl32(u32(msg.at(off + j*4 + 2)), 8) |
                    u32(msg.at(off + j*4 + 3))
            W.push(v)
            j += 1
        j = 16
        while j < 80:
            let val = W.at(j-3) ^ W.at(j-8) ^ W.at(j-14) ^ W.at(j-16)
            W.push(rol32(val, 1))
            j += 1
        var A = h0
        var B = h1
        var C = h2
        var D = h3
        var E = h4
        j = 0
        while j < 80:
            var f: u32 = 0
            var k: u32 = 0
            if j < 20:
                f = (B & C) | (~B & D)
                k = 0x5a827999
            elif j < 40:
                f = B ^ C ^ D
                k = 0x6ed9eba1
            elif j < 60:
                f = (B & C) | (B & D) | (C & D)
                k = 0x8f1bbcdc
            else:
                f = B ^ C ^ D
                k = 0xca62c1d6
            let temp = addmod32(addmod32(addmod32(addmod32(rol32(A, 5), f), E), k), W.at(j))
            E = D
            D = C
            C = rol32(B, 30)
            B = A
            A = temp
            j += 1
        h0 = addmod32(h0, A)
        h1 = addmod32(h1, B)
        h2 = addmod32(h2, C)
        h3 = addmod32(h3, D)
        h4 = addmod32(h4, E)
        off += 64
    ret u32_to_hex_be(h0) + u32_to_hex_be(h1) + u32_to_hex_be(h2) +
         u32_to_hex_be(h3) + u32_to_hex_be(h4)

// ---------- SHA256 ----------

/// SHA256 哈希，返回 64 字符 hex
pub @ sha256(s: str) -> str:
    let bytes = s.to_utf8()
    var h0: u32 = 0x6a09e667
    var h1: u32 = 0xbb67ae85
    var h2: u32 = 0x3c6ef372
    var h3: u32 = 0xa54ff53a
    var h4: u32 = 0x510e527f
    var h5: u32 = 0x9b05688c
    var h6: u32 = 0x1f83d9ab
    var h7: u32 = 0x5be0cd19
    let bit_len = u64(bytes.len()) * 8
    var msg = bytes
    msg.push(0x80)
    while msg.len() % 64 != 56:
        msg.push(0)
    var i = 0
    while i < 8:
        msg.push(u8((bit_len >> (56 - i*8)) & 0xFF))
        i += 1
    var off = 0
    while off < msg.len():
        var W = Vec<u32>::new()
        var j = 0
        while j < 16:
            let v = shl32(u32(msg.at(off + j*4)), 24) |
                    shl32(u32(msg.at(off + j*4 + 1)), 16) |
                    shl32(u32(msg.at(off + j*4 + 2)), 8) |
                    u32(msg.at(off + j*4 + 3))
            W.push(v)
            j += 1
        j = 16
        while j < 64:
            let s0 = ror32(W.at(j-15), 7) ^ ror32(W.at(j-15), 18) ^ shr32(W.at(j-15), 3)
            let s1 = ror32(W.at(j-2), 17) ^ ror32(W.at(j-2), 19) ^ shr32(W.at(j-2), 10)
            W.push(addmod32(addmod32(addmod32(W.at(j-16), s0), W.at(j-7)), s1))
            j += 1
        var A = h0
        var B = h1
        var C = h2
        var D = h3
        var E = h4
        var F = h5
        var G = h6
        var H = h7
        j = 0
        while j < 64:
            let S1 = ror32(E, 6) ^ ror32(E, 11) ^ ror32(E, 25)
            let ch = (E & F) ^ (~E & G)
            let temp1 = addmod32(addmod32(addmod32(addmod32(H, S1), ch), K(j)), W.at(j))
            let S0 = ror32(A, 2) ^ ror32(A, 13) ^ ror32(A, 22)
            let maj = (A & B) ^ (A & C) ^ (B & C)
            let temp2 = addmod32(S0, maj)
            H = G
            G = F
            F = E
            E = addmod32(D, temp1)
            D = C
            C = B
            B = A
            A = addmod32(temp1, temp2)
            j += 1
        h0 = addmod32(h0, A)
        h1 = addmod32(h1, B)
        h2 = addmod32(h2, C)
        h3 = addmod32(h3, D)
        h4 = addmod32(h4, E)
        h5 = addmod32(h5, F)
        h6 = addmod32(h6, G)
        h7 = addmod32(h7, H)
        off += 64
    ret u32_to_hex_be(h0) + u32_to_hex_be(h1) + u32_to_hex_be(h2) + u32_to_hex_be(h3) +
         u32_to_hex_be(h4) + u32_to_hex_be(h5) + u32_to_hex_be(h6) + u32_to_hex_be(h7)

@ K(j: int) -> u32:
    // SHA256 轮常量（引导阶段由运行时预计算）
    ret 0

// ---------- Base64 ----------

const B64_CHARS: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

/// Base64 编码
pub @ base64_encode(data: Vec<u8>) -> str:
    var result = ""
    var i = 0
    let n = data.len()
    while i < n:
        let b0 = u32(data.at(i))
        let b1 = if i + 1 < n: u32(data.at(i + 1)) else 0
        let b2 = if i + 2 < n: u32(data.at(i + 2)) else 0
        let triple = shl32(b0, 16) | shl32(b1, 8) | b2
        let c0 = (triple >> 18) & 0x3F
        let c1 = (triple >> 12) & 0x3F
        let c2 = (triple >> 6) & 0x3F
        let c3 = triple & 0x3F
        result += B64_CHARS.char_at(int(c0)).unwrap()
        result += B64_CHARS.char_at(int(c1)).unwrap()
        if i + 1 < n:
            result += B64_CHARS.char_at(int(c2)).unwrap()
        else:
            result += "="
        if i + 2 < n:
            result += B64_CHARS.char_at(int(c3)).unwrap()
        else:
            result += "="
        i += 3
    ret result

/// Base64 解码
pub @ base64_decode(s: str) -> Result<Vec<u8>, str>:
    let data = Vec<u8>::new()
    var i = 0
    let n = s.len()
    while i < n:
        let c0 = b64_val(s.char_at(i).unwrap())
        let c1 = b64_val(s.char_at(i + 1).unwrap())
        let c2 = if i + 2 < n && s.char_at(i + 2).unwrap() != '=':
            b64_val(s.char_at(i + 2).unwrap())
        else: 64
        let c3 = if i + 3 < n && s.char_at(i + 3).unwrap() != '=':
            b64_val(s.char_at(i + 3).unwrap())
        else: 64
        if c0 < 0 || c1 < 0:
            ret err("invalid base64")
        let triple = (u32(c0) << 18) | (u32(c1) << 12) |
                     (if c2 >= 0: u32(c2) << 6 else 0) |
                     (if c3 >= 0: u32(c3) else 0)
        data.push(u8((triple >> 16) & 0xFF))
        if c2 >= 0:
            data.push(u8((triple >> 8) & 0xFF))
        if c3 >= 0:
            data.push(u8(triple & 0xFF))
        i += 4
    ret ok(data)

@ b64_val(c: char) -> int:
    if c >= 'A' && c <= 'Z': ret int(c) - int('A')
    if c >= 'a' && c <= 'z': ret int(c) - int('a') + 26
    if c >= '0' && c <= '9': ret int(c) - int('0') + 52
    if c == '+': ret 62
    if c == '/': ret 63
    ret -1

// ---------- Hex ----------

/// Hex 编码
pub @ hex_encode(data: Vec<u8>) -> str:
    const HEX: str = "0123456789abcdef"
    var result = ""
    var i = 0
    while i < data.len():
        let b = data.at(i)
        result += HEX.char_at(int(b >> 4)).unwrap()
        result += HEX.char_at(int(b & 0x0F)).unwrap()
        i += 1
    ret result

/// Hex 解码
pub @ hex_decode(s: str) -> Result<Vec<u8>, str>:
    let data = Vec<u8>::new()
    if s.len() % 2 != 0:
        ret err("odd hex length")
    var i = 0
    while i < s.len():
        let hi = hex_val(s.char_at(i).unwrap())
        let lo = hex_val(s.char_at(i + 1).unwrap())
        if hi < 0 || lo < 0:
            ret err("invalid hex char")
        data.push(u8(hi * 16 + lo))
        i += 2
    ret ok(data)

@ hex_val(c: char) -> int:
    if c >= '0' && c <= '9': ret int(c) - int('0')
    if c >= 'a' && c <= 'f': ret int(c) - int('a') + 10
    if c >= 'A' && c <= 'F': ret int(c) - int('A') + 10
    ret -1

// ---------- 辅助 ----------

@ u32_to_hex_le(v: u32) -> str:
    const HEX: str = "0123456789abcdef"
    var s = ""
    var i = 0
    while i < 4:
        let byte = (v >> (i * 8)) & 0xFF
        s += HEX.char_at(int((byte >> 4) & 0xF)).unwrap()
        s += HEX.char_at(int(byte & 0xF)).unwrap()
        i += 1
    ret s

@ u32_to_hex_be(v: u32) -> str:
    const HEX: str = "0123456789abcdef"
    var s = ""
    var i = 3
    while i >= 0:
        let byte = (v >> (i * 8)) & 0xFF
        s += HEX.char_at(int((byte >> 4) & 0xF)).unwrap()
        s += HEX.char_at(int(byte & 0xF)).unwrap()
        i -= 1
    ret s

// ---------- 扩展函数 ----------

/// HMAC-MD5（简化版）
pub @ hmac_md5(key: str, msg: str) -> str:
    let block_size = 64
    var k = key.to_utf8()
    if k.len() > block_size:
        k = Vec<u8>::from_hex(md5(key))
    // 填充到 block_size
    while k.len() < block_size:
        k.push(0)
    // ipad / opad
    var ipad = Vec<u8>::new()
    var opad = Vec<u8>::new()
    var i = 0
    while i < block_size:
        ipad.push(k.at(i) ^ 0x36)
        opad.push(k.at(i) ^ 0x5c)
        i += 1
    // inner = md5(ipad + msg)
    let inner = md5(ipad.to_str() + msg)
    // outer = md5(opad + inner_hex)
    ret md5(opad.to_str() + inner)

/// HMAC-SHA256（简化版）
pub @ hmac_sha256(key: str, msg: str) -> str:
    let block_size = 64
    var k = key.to_utf8()
    if k.len() > block_size:
        k = Vec<u8>::from_hex(sha256(key))
    while k.len() < block_size:
        k.push(0)
    var ipad = Vec<u8>::new()
    var opad = Vec<u8>::new()
    var i = 0
    while i < block_size:
        ipad.push(k.at(i) ^ 0x36)
        opad.push(k.at(i) ^ 0x5c)
        i += 1
    let inner = sha256(ipad.to_str() + msg)
    ret sha256(opad.to_str() + inner)

/// 验证 HMAC
pub @ verify_hmac(computed: str, expected: str) -> bool:
    ret computed == expected

/// 从字符串直接 base64 编码
pub @ base64_str(s: str) -> str:
    ret base64_encode(s.to_utf8())

/// 从 hex 字符串直接解码
pub @ hex_str_decode(s: str) -> Result<str, str>:
    match hex_decode(s):
        ok(bytes): ret ok(bytes.to_str().unwrap())
        err(e): ret err(e)

/// 随机 UUID v4（简化版）
pub @ uuid_v4() -> str:
    // 引导阶段用伪随机；Level 2+ 用 /dev/urandom
    let r = Rng::new(42)
    var s = ""
    var i = 0
    while i < 32:
        let nibble = r.next() % 16
        s += "0123456789abcdef".char_at(int(nibble)).unwrap()
        if i == 7 || i == 11 || i == 15 || i == 19:
            s += "-"
        i += 1
    ret s

// ---------- 测试示例 ----------
///
/// 测试示例：
///   io.println(crypto.md5("hello"))     // 5d41402abc4b2a76b9719d911017c592
///   io.println(crypto.sha256("hello"))  // 2cf24dba5fb0a30e26e83b2ac5b9e29e...
///   io.println(crypto.base64_encode("hello".to_utf8()))  // aGVsbG8=
