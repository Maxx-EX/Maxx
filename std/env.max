//! std.env — 环境变量（真实实现）。

// 运行时原语
@ sys_env_get(key: str) -> ?str
@ sys_env_set(key: str, val: str) -> ()
@ sys_env_home() -> ?str
@ sys_env_temp() -> ?str

/// 获取环境变量
pub @ get(key: str) -> ?str:
    ret sys_env_get(key)

/// 设置环境变量
pub @ set(key: str, val: str) -> ():
    sys_env_set(key, val)

/// 获取或默认
pub @ get_or(key: str, default: str) -> str:
    match sys_env_get(key):
        some(v): ret v
        none: ret default

/// 是否存在
pub @ has(key: str) -> bool:
    ret sys_env_get(key) != none

/// 用户主目录
pub @ home() -> str:
    match sys_env_home():
        some(p): ret p
        none: ret "/tmp"

/// 临时目录
pub @ temp() -> str:
    match sys_env_temp():
        some(p): ret p
        none: ret "/tmp"
