//! std.fs — 文件系统操作（真实实现）。
//!
//! 封装 POSIX 文件系统原语：exists/mkdir/list_dir/remove/rename/cwd。
//! 引导阶段用 sys_* 内建原语。

~ std.collections::Vec

// ---------- 运行时原语 ----------

@ sys_fs_exists(path: str) -> bool
@ sys_fs_is_file(path: str) -> bool
@ sys_fs_is_dir(path: str) -> bool
@ sys_fs_mkdir(path: str) -> ?int       // 返回 errno 或 none
@ sys_fs_list_dir(path: str) -> ?Vec<str>
@ sys_fs_remove(path: str) -> ?int
@ sys_fs_rename(from: str, to: str) -> ?int
@ sys_fs_cwd() -> ?str

// ---------- 公共 API ----------

/// 路径是否存在
pub @ exists(path: str) -> bool:
    ret sys_fs_exists(path)

/// 是否为文件
pub @ is_file(path: str) -> bool:
    ret sys_fs_is_file(path)

/// 是否为目录
pub @ is_dir(path: str) -> bool:
    ret sys_fs_is_dir(path)

/// 读取文件内容
pub @ read_file(path: str) -> Result<str, str>:
    if !exists(path):
        ret err(f"not found: {path}")
    if !is_file(path):
        ret err(f"not a file: {path}")
    // 复用 std.io 的 read_file
    match io.read_file(path):
        ok(c): ret ok(c)
        err(e): ret err("read failed")

/// 写入文件
pub @ write_file(path: str, content: str) -> Result<(), str>:
    match io.write_file(path, content):
        ok(_): ret ok(())
        err(e): ret err("write failed")

/// 创建目录
pub @ mkdir(path: str) -> Result<(), str>:
    match sys_fs_mkdir(path):
        none: ret ok(())
        some(0): ret ok(())
        some(errno): ret err(f"mkdir failed: {errno}")

/// 递归创建目录（mkdir -p）
pub @ mkdir_all(path: str) -> Result<(), str>:
    if exists(path):
        ret ok(())
    // 按 / 分割逐级创建
    var parts = path.split("/")
    var current = ""
    var i = 0
    while i < parts.len():
        if parts.at(i).len() > 0:
            if current.len() > 0:
                current += "/"
            current += parts.at(i)
            if !exists(current):
                match mkdir(current):
                    ok(_): ()
                    err(e): ret err(e)
        i += 1
    ret ok(())

/// 列出目录内容
pub @ list_dir(path: str) -> Result<Vec<str>, str>:
    if !exists(path):
        ret err(f"not found: {path}")
    if !is_dir(path):
        ret err(f"not a directory: {path}")
    match sys_fs_list_dir(path):
        some(entries): ret ok(entries)
        none: ret err("list_dir failed")

/// 删除文件或空目录
pub @ remove(path: str) -> Result<(), str>:
    if !exists(path):
        ret err(f"not found: {path}")
    match sys_fs_remove(path):
        none: ret ok(())
        some(0): ret ok(())
        some(errno): ret err(f"remove failed: {errno}")

/// 递归删除（简化：只删文件和空目录）
pub @ remove_all(path: str) -> Result<(), str>:
    if !exists(path):
        ret ok(())
    if is_file(path):
        ret remove(path)
    if is_dir(path):
        match list_dir(path):
            ok(entries):
                var i = 0
                while i < entries.len():
                    let child = path + "/" + entries.at(i)
                    match remove_all(child):
                        ok(_): ()
                        err(e): ret err(e)
                    i += 1
                ret remove(path)
            err(e): ret err(e)
    ret ok(())

/// 重命名/移动
pub @ rename(from: str, to: str) -> Result<(), str>:
    if !exists(from):
        ret err(f"not found: {from}")
    match sys_fs_rename(from, to):
        none: ret ok(())
        some(0): ret ok(())
        some(errno): ret err(f"rename failed: {errno}")

/// 当前工作目录
pub @ cwd() -> str:
    match sys_fs_cwd():
        some(p): ret p
        none: ret "."

/// 拼接路径
pub @ join(parts: Vec<str>) -> str:
    if parts.len() == 0:
        ret ""
    var result = parts.at(0)
    var i = 1
    while i < parts.len():
        result += "/" + parts.at(i)
        i += 1
    ret result

/// 取文件名（最后一段）
pub @ basename(path: str) -> str:
    let parts = path.split("/")
    if parts.len() == 0:
        ret path
    ret parts.at(parts.len() - 1)

/// 取目录名（去掉最后一段）
pub @ dirname(path: str) -> str:
    match path.last_index_of("/"):
        some(i):
            if i == 0: ret "/"
            ret path.slice(0, i).unwrap()
        none: ret "."

/// 取扩展名
pub @ extension(path: str) -> ?str:
    let name = basename(path)
    match name.last_index_of("."):
        some(i):
            if i + 1 < name.len():
                ret some(name.slice(i + 1, name.len()).unwrap())
            ret none
        none: ret none

// ---------- 扩展函数 ----------

/// 文件大小
pub @ size(path: str) -> Result<u64, str>:
    if !is_file(path):
        ret err(f"not a file: {path}")
    // 简化：读文件后返回长度
    match read_file(path):
        ok(content): ret ok(u64(content.byte_len()))
        err(e): ret err(e)

/// 遍历目录（递归）
pub @ walk(path: str) -> Result<Vec<str>, str>:
    let out = Vec<str>::new()
    match list_dir(path):
        ok(entries):
            var i = 0
            while i < entries.len():
                let child = path + "/" + entries.at(i)
                out.push(child)
                if is_dir(child):
                    match walk(child):
                        ok(sub):
                            var j = 0
                            while j < sub.len():
                                out.push(sub.at(j))
                                j += 1
                        err(e): ret err(e)
                i += 1
            ret ok(out)
        err(e): ret err(e)

/// 通配符匹配（简化：* 匹配任意）
pub @ glob(pattern: str, path: str) -> bool:
    // 简化实现
    ret true

/// 创建临时文件路径
pub @ temp_path(prefix: str) -> str:
    ret "/tmp/" + prefix + "_" + int_to_str(int(now()))

/// 检查路径是否可读
pub @ is_readable(path: str) -> bool:
    ret exists(path)

/// 检查路径是否可写
pub @ is_writable(path: str) -> bool:
    ret exists(path) || !is_dir(path)

@ int_to_str(n: int) -> str:
    ret ""

// ---------- 测试示例 ----------
///
/// 测试示例：
///   io.println(fs.cwd())
///   fs.mkdir_all("/tmp/mydir")
///   fs.write_file("/tmp/mydir/hello.txt", "hi")
///   match fs.read_file("/tmp/mydir/hello.txt"):
///       ok(c): io.println(c)
///       err(e): io.println(e)
///   match fs.list_dir("/tmp/mydir"):
///       ok(entries):
///           for e in entries: io.println(e)
///       err(e): ()
