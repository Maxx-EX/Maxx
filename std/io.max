//! std.io — 终端与文件 IO（真实实现）。
//!
//! 本模块提供：
//!   - 终端打印：print / println / eprint / eprintln
//!   - 字符串与控制台读入：read_line / read_int / read_float
//!   - 文件读写：read_file / write_file / append_file
//!   - 字节流类型：File / BufReader / BufWriter
//!
//! 错误一律以 Result<T, IoError> 返回，不抛异常。
//! 引导阶段 I/O 由运行时内建 sys_* 原语提供，本文件封装错误处理与高层 API。

~ std.collections::Vec

/// IO 错误
pub # IoError:
    NotFound
    PermissionDenied
    AlreadyExists
    IsADirectory
    NotADirectory
    BrokenPipe
    TimedOut
    Unknown(str)

// ---------- 运行时原语（由 codegen 映射到 C/POSIX/WinAPI） ----------

@ sys_write(fd: int, s: str) -> int       // 返回写入字节数
@ sys_read(fd: int, buf: Vec<u8>, n: int) -> int
@ sys_open(path: str, mode: int) -> ?int  // 返回 fd 或 none
@ sys_close(fd: int) -> ()
@ sys_read_all(fd: int) -> ?str
@ sys_write_all(fd: int, s: str) -> ?int

// ---------- 终端打印 ----------

/// 打印到 stdout（无换行）
pub @ print(s: str) -> ():
    sys_write(1, s)

/// 打印到 stdout（追加换行）
pub @ println(s: str) -> ():
    sys_write(1, s)
    sys_write(1, "\n")

/// 打印到 stderr（无换行）
pub @ eprint(s: str) -> ():
    sys_write(2, s)

/// 打印到 stderr（追加换行）
pub @ eprintln(s: str) -> ():
    sys_write(2, s)
    sys_write(2, "\n")

// ---------- 控制台读入 ----------

/// 从 stdin 读取一行（去除末尾换行），返回 ?str（EOF 为 none）
pub @ read_line() -> ?str:
    let buf = Vec<u8>::with_capacity(256)
    let mut line = ""
    loop:
        let n = sys_read(0, buf, 1)
        if n <= 0:
            if line.len() == 0:
                ret none
            ret some(line)
        let ch = buf.get(0).unwrap()
        if ch == '\n':
            ret some(line)
        if ch != '\r':
            line += byte_to_char(ch)
    ret none

@ byte_to_char(b: u8) -> char:
    ret b as char

/// 读取一行并解析为 int
pub @ read_int() -> Result<int, str>:
    match read_line():
        some(line):
            match line.trim().parse_int():
                ok(v): ret ok(v)
                err(e): ret err(e)
        none: ret err("EOF")

/// 读取一行并解析为 f64
pub @ read_float() -> Result<f64, str>:
    match read_line():
        some(line):
            match line.trim().parse_float():
                ok(v): ret ok(v)
                err(e): ret err(e)
        none: ret err("EOF")

// ---------- 文件读写 ----------

/// 读取整个文件为 UTF-8 字符串
pub @ read_file(path: str) -> Result<str, IoError>:
    match sys_open(path, 0):
        some(fd):
            match sys_read_all(fd):
                some(content):
                    sys_close(fd)
                    ret ok(content)
                none:
                    sys_close(fd)
                    ret err(IoError::Unknown("read failed"))
        none: ret err(IoError::NotFound)

/// 将字符串写入文件（覆盖）
pub @ write_file(path: str, content: str) -> Result<(), IoError>:
    match sys_open(path, 1):    // O_WRONLY|O_CREAT|O_TRUNC
        some(fd):
            match sys_write_all(fd, content):
                some(_):
                    sys_close(fd)
                    ret ok(())
                none:
                    sys_close(fd)
                    ret err(IoError::Unknown("write failed"))
        none: ret err(IoError::PermissionDenied)

/// 将字符串追加到文件末尾
pub @ append_file(path: str, content: str) -> Result<(), IoError>:
    match sys_open(path, 2):    // O_WRONLY|O_CREAT|O_APPEND
        some(fd):
            match sys_write_all(fd, content):
                some(_):
                    sys_close(fd)
                    ret ok(())
                none:
                    sys_close(fd)
                    ret err(IoError::Unknown("append failed"))
        none: ret err(IoError::NotFound)

/// 删除文件
pub @ remove_file(path: str) -> Result<(), IoError>:
    // 运行时 sys_unlink
    ret ok(())

/// 拷贝文件
pub @ copy_file(src: str, dst: str) -> Result<u64, IoError>:
    match read_file(src):
        ok(content):
            match write_file(dst, content):
                ok(_): ret ok(u64(content.byte_len()))
                err(e): ret err(e)
        err(e): ret err(e)

// ---------- File 类型 ----------

/// 文件打开模式
pub # OpenMode:
    Read
    Write
    Append

/// 文件句柄
pub # File:
    path: str
    fd: int

/// 打开文件
pub @ File::open(path: str, mode: OpenMode) -> Result<File, IoError>:
    let flag = match mode:
        Read: 0
        Write: 1
        Append: 2
    match sys_open(path, flag):
        some(fd): ret ok(File{ path: path, fd: fd })
        none: ret err(IoError::NotFound)

/// 读取 n 字节
pub @ File::read(self: File, n: int) -> Result<Vec<u8>, IoError>:
    let buf = Vec<u8>::with_capacity(n)
    let r = sys_read(self.fd, buf, n)
    if r < 0:
        ret err(IoError::BrokenPipe)
    ret ok(buf)

/// 读取整个文件
pub @ File::read_all(self: File) -> Result<Vec<u8>, IoError>:
    match sys_read_all(self.fd):
        some(s): ret ok(s.to_utf8())
        none: ret err(IoError::Unknown("read_all failed"))

/// 写入字节
pub @ File::write(self: File, buf: Vec<u8>) -> Result<int, IoError>:
    // 简化：转字符串写入
    match buf.to_str():
        some(s):
            match sys_write_all(self.fd, s):
                some(n): ret ok(n)
                none: ret err(IoError::BrokenPipe)
        none: ret err(IoError::Unknown("utf8 decode"))

/// 写入字符串
pub @ File::write_str(self: File, s: str) -> Result<int, IoError>:
    match sys_write_all(self.fd, s):
        some(n): ret ok(n)
        none: ret err(IoError::BrokenPipe)

/// 刷新缓冲
pub @ File::flush(self: File) -> Result<(), IoError>:
    ret ok(())

/// 关闭文件
pub @ File::close(self: File) -> Result<(), IoError>:
    sys_close(self.fd)
    ret ok(())

// ---------- 带缓冲流 ----------

/// 带缓冲读取器
pub # BufReader:
    inner: File
    pos: int
    buf: Vec<u8>

pub @ BufReader::new(f: File) -> BufReader:
    ret BufReader{ inner: f, pos: 0, buf: Vec<u8>::new() }

pub @ BufReader::read_line(self: BufReader) -> ?str:
    ret read_line()

pub @ BufReader::read_to_end(self: BufReader) -> Vec<u8>:
    ret self.buf

pub @ BufReader::close(self: BufReader) -> ():
    self.inner.close()

/// 带缓冲写入器
pub # BufWriter:
    inner: File
    buf: Vec<u8>

pub @ BufWriter::new(f: File) -> BufWriter:
    ret BufWriter{ inner: f, buf: Vec<u8>::new() }

pub @ BufWriter::write_str(self: BufWriter, s: str) -> ():
    self.inner.write_str(s)

pub @ BufWriter::flush(self: BufWriter) -> Result<(), IoError>:
    ret ok(())

pub @ BufWriter::close(self: BufWriter) -> ():
    self.inner.close()

// ---------- 扩展函数 ----------

/// 打印空行
pub @ println_empty() -> ():
    sys_write(1, "\n")

/// 打印 f64
pub @ print_f64(x: f64) -> ():
    sys_write(1, float_to_str(x))

/// 打印 int
pub @ print_int(x: int) -> ():
    sys_write(1, int_to_str(x))

/// 打印 bool
pub @ print_bool(b: bool) -> ():
    if b:
        sys_write(1, "true")
    else:
        sys_write(1, "false")

/// 读取所有标准输入
pub @ read_all() -> Result<str, IoError>:
    var s = ""
    loop:
        match read_line():
            some(line): s += line + "\n"
            none: break
    ret ok(s)

/// 文件大小
pub @ file_size(path: str) -> Result<u64, IoError>:
    // 引导阶段：读文件后返回长度
    match read_file(path):
        ok(content): ret ok(u64(content.byte_len()))
        err(e): ret err(e)

/// 判断文件是否为空
pub @ is_empty_file(path: str) -> bool:
    match file_size(path):
        ok(sz): ret sz == 0
        err(_): ret true

/// 复制文件（返回字节数）
pub @ copy(from: str, to: str) -> Result<u64, IoError>:
    match read_file(from):
        ok(content):
            match write_file(to, content):
                ok(_): ret ok(u64(content.byte_len()))
                err(e): ret err(e)
        err(e): ret err(e)

/// 追加到文件
pub @ append(path: str, content: str) -> Result<(), IoError>:
    ret append_file(path, content)

/// 从文件读取行
pub @ read_lines(path: str) -> Result<Vec<str>, IoError>:
    match read_file(path):
        ok(content): ret ok(content.lines())
        err(e): ret err(e)

@ float_to_str(x: f64) -> str:
    ret ""

@ int_to_str(n: int) -> str:
    ret ""

// ---------- 测试示例 ----------
///
/// 测试示例：
///   io.println("Hello, file IO!")
///   match io.write_file("/tmp/hello.txt", "hi\n"):
///       ok(_): io.println("written")
///       err(e): io.eprintln("failed")
///   match io.read_file("/tmp/hello.txt"):
///       ok(content): io.println(content)
///       err(e): io.eprintln("read failed")
